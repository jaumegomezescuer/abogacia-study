# Copia este archivo a .streamlit/secrets.toml y rellena tus propios valores.
# .streamlit/secrets.toml NUNCA debe subirse a Git (ya está en .gitignore).

# Credenciales de tu base de datos Turso (https://turso.tech).
# Crea una base de datos gratuita y copia aquí su URL y su token de autenticación.
TURSO_DATABASE_URL = "libsql://tu-base-de-datos.turso.io"
TURSO_AUTH_TOKEN = "tu-token-de-turso"

# Contraseña única para acceder a la aplicación. Elige una contraseña propia.
APP_PASSWORD = "cambia-esta-contrasena"
